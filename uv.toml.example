# Copy to uv.toml (git-ignored) to develop against local checkouts of the
# sibling packages instead of the git commits pinned in pyproject.toml.
# CI never sees this file, so it always installs the pinned commits.
[sources]
poster-core = { path = "../poster-core", editable = true, extras = ["all"] }
info-snipe = { path = "../info-snipe", editable = true }
