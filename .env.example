# Copy to .env and fill in what you use. Never commit .env (it is git-ignored).
# In GitHub Actions, set the same names as repository secrets instead
# (Settings -> Secrets and variables -> Actions).

# --- Core ---------------------------------------------------------------------

# Postgres for post history, dedup, metrics and refreshed tokens. Optional for a
# first --dry-run; without it narovva cannot avoid reposting the same story.
# Neon's free tier works: https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Encrypts refreshed Instagram tokens at rest (instagram_tokens table). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Vercel Blob: Instagram fetches media from a public URL, so each reel is
# uploaded here just long enough to publish. Vercel -> Storage -> Blob.
BLOB_READ_WRITE_TOKEN=

# --- Text models (at least one; the channel's llm_chain lists the order) -------

# Claude (paid, the primary model): https://platform.claude.com -> API keys.
# Billed to the Console organization, not to a claude.ai Pro/Max subscription.
ANTHROPIC_API_KEY=
# Or a claude.ai Pro/Max plan: run `claude setup-token` and paste the token here (and as the
# CLAUDE_CODE_OAUTH_TOKEN repo secret). Needs the Claude Code CLI; shares the plan's usage limit.
CLAUDE_CODE_OAUTH_TOKEN=

# Gemini, free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OpenAI (paid); also used for OpenAI text-to-speech if the channel narrates with it
OPENAI_API_KEY=
# Optional: OpenRouter ":free" models
OPENROUTER_API_KEY=

# --- Per channel ----------------------------------------------------------------
# The variable names are whatever the channel YAML's credentials.* fields say;
# these are the ones config/channels/example-tech-ig.yaml uses.

# Instagram API with Instagram Login, long-lived (60-day) token. narovva
# refreshes it weekly and keeps the fresh copy in Postgres.
IG_ACCESS_TOKEN__example_tech_ig=

# Optional: background music from Jamendo (https://devportal.jamendo.com)
JAMENDO_CLIENT_ID__example_tech_ig=

# --- Optional -------------------------------------------------------------------

# Adds NewsAPI.org alongside the RSS feeds
NEWSAPI_KEY=
# Only for auditioning voices (python -m narovva.narration.demo elevenlabs out/)
ELEVENLABS_API_KEY=

# Local tooling overrides (rarely needed):
#   HYPERFRAMES_BIN     path to the hyperframes CLI (default: npx hyperframes)
#   CHROME_BIN          Chrome used by python -m narovva.motion.preview
#   NAROVVA_KOKORO_DIR  where the Kokoro voice model is cached
