# Postgres (Neon pooled connection string recommended for serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob (auto-injected by Vercel once a Blob store is attached to the
# project; set manually for local runs)
BLOB_READ_WRITE_TOKEN=

# Shared secret required as a Bearer token on api/cron/* requests
CRON_SECRET=

# Fernet symmetric key used to encrypt refreshed Instagram tokens at rest in
# the instagram_tokens table. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# LLM providers (only the ones referenced by a channel's text_provider /
# image_provider need to be set)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: enables the NewsAPI.org source in info-snipe alongside RSS
NEWSAPI_KEY=

# Per-channel Instagram credentials. Name follows the convention referenced
# by that channel's config/channels/<id>.yaml credentials.* fields:
#   IG_ACCESS_TOKEN__<channel_id>=<long-lived user or page token>
#   IG_APP_ID__<channel_id>=<Meta app id, used for token refresh>
#   IG_APP_SECRET__<channel_id>=<Meta app secret, used for token refresh>
IG_ACCESS_TOKEN__example_tech_ig=
IG_APP_ID__example_tech_ig=
IG_APP_SECRET__example_tech_ig=
